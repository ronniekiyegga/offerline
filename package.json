{
  "name": "subscription-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "fast-uri": "3.1.8",
      "mysql2": "3.23.1",
      "qs": "6.16.0"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "cross-env NODE_ENV=production tsx index.ts",
    "dev": "cross-env NODE_ENV=development tsx watch index.ts",
    "lint": "eslint .",
    "typecheck": "pnpm exec prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@arcjet/node": "^1.14.0",
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.3",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "jiti": "^2.6.1",
    "prisma": "^7.10.0",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.1.1"
  }
}
