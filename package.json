{
  "name": "offerline",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.21.0 <23"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "fast-uri": "3.1.8",
      "mysql2": "3.23.1",
      "proxy-addr": "2.0.8",
      "qs": "6.16.0",
      "source-map-js": "1.2.2"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @offerline/api --filter @offerline/web run dev",
    "dev:api": "pnpm --filter @offerline/api run dev",
    "dev:web": "pnpm --filter @offerline/web run dev",
    "build:api": "pnpm --filter @offerline/api run build",
    "build:web": "pnpm --filter @offerline/web run build",
    "start:api": "pnpm --filter @offerline/api run start",
    "start:web": "pnpm --filter @offerline/web run start",
    "prisma:generate": "pnpm --filter @offerline/api exec prisma generate",
    "prisma:validate": "pnpm --filter @offerline/api exec prisma validate",
    "typecheck": "pnpm --filter @offerline/api run typecheck && pnpm --filter @offerline/web run typecheck",
    "lint": "pnpm --filter @offerline/api run lint && pnpm --filter @offerline/web run lint",
    "test": "pnpm --filter @offerline/api run test && pnpm --filter @offerline/web run test",
    "test:watch:api": "pnpm --filter @offerline/api run test:watch",
    "test:watch:web": "pnpm --filter @offerline/web run test:watch",
    "check": "pnpm run prisma:validate && pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build:api && pnpm run build:web"
  }
}
