// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  USD
  EUR
  GBP
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionCategory {
  SPORTS
  MUSIC
  ENTERTAINMENT
  LIFESTYLE
  TECHNOLOGY
  FINANCE
  POLITICS
  OTHERS
}

/// Generic lifecycle for a user’s plan assignment.
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

model User {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(50)
  email         String         @unique @db.VarChar(255)
  /// Store a hash (e.g. bcrypt), not plain text.
  password      String         @db.VarChar(255)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
}

/// Catalog of billable plans (reusable reference data).
model Plan {
  id         Int                 @id @default(autoincrement())
  name       String              @db.VarChar(200)
  price      Int
  currency   Currency            @default(GBP)
  frequency  BillingFrequency
  /// Preserves the optional classification used by legacy subscription records.
  category   SubscriptionCategory?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  assignments Subscription[]
}

/// User’s subscription to a plan (renamed in API as “billing” / subscribe flow).
model Subscription {
  id            Int                 @id @default(autoincrement())
  planId        Int
  plan          Plan                @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  /// Opaque key/value usage signals for demos (e.g. { "apiCalls": 1200, "seats": 3 }).
  usageMetrics  Json                @default("{}")
  status        SubscriptionStatus  @default(ACTIVE)
  startDate     DateTime
  renewalDate   DateTime

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([planId])
}
